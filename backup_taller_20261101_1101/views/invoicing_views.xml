<odoo>
    <record id="view_service_order_form_invoicing" model="ir.ui.view">
        <field name="name">service.order.form.invoicing</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="before">
                <button name="action_create_invoice" string="Crear factura" type="object"
                        groups="taller.group_taller_manager"
                        invisible="status not in ['done', 'delivered'] or invoice_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="invoice_id" invisible="1"/>
                <button name="action_view_invoice" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" groups="taller.group_taller_manager"
                        invisible="not invoice_id">
                    <div class="o_stat_info"><span class="o_stat_text">Factura</span></div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_service_order_search_invoicing" model="ir.ui.view">
        <field name="name">service.order.search.invoicing</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='f_mine']" position="after">
                <filter name="f_to_invoice" string="Sin facturar"
                        domain="[('status', 'in', ['done', 'delivered']), ('invoice_id', '=', False), ('no_charge', '=', False), ('total', '&gt;', 0)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_taller" model="ir.ui.view">
        <field name="name">account.move.form.taller</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//div[hasclass('oe_title')])[1]" position="after">
                <div class="alert alert-warning" role="alert"
                     invisible="not service_order_id">
                    Documento interno de contabilidad. El comprobante fiscal se emite en el portal
                    de la DGI: cargue aquí su serie y número.
                </div>
                <group invisible="not service_order_id">
                    <group>
                        <field name="service_order_id"/>
                        <field name="dgi_serie"/>
                        <field name="dgi_number"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Datos para DGI" invisible="not service_order_id">
                    <field name="dgi_summary" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_to_invoice" model="ir.actions.act_window">
        <field name="name">Órdenes por facturar</field>
        <field name="res_model">service.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ['done', 'delivered']), ('invoice_id', '=', False), ('no_charge', '=', False), ('total', '&gt;', 0)]</field>
        <field name="search_view_id" ref="view_service_order_search"/>
    </record>

    <menuitem id="menu_taller_to_invoice" name="Por facturar" parent="menu_taller_root"
              action="action_to_invoice" sequence="12" groups="group_taller_manager"/>
</odoo>