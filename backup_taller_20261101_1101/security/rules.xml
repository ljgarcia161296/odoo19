        <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.user_id', '=', False)]</field>
    </record>
    <record id="rule_service_order_check_manager" model="ir.rule">
        <field name="name">Taller: el administrador ve todos los checklists</field>
        <field name="model_id" ref="model_service_order_check"/>
        <field name="groups" eval="[(4, ref('group_taller_manager'))]"/>
