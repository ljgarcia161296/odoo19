<odoo>
    <record id="view_service_order_form_extras" model="ir.ui.view">
        <field name="name">service.order.form.extras</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="before">
                <button name="action_send_quote" string="Enviar presupuesto" type="object"
                        invisible="status != 'diagnosing'"/>
                <button name="action_approve_quote" string="Aprobar presupuesto" type="object"
                        class="btn-primary" invisible="status != 'quote'"/>
                <button name="action_reject_quote" string="Rechazar presupuesto" type="object"
                        invisible="status != 'quote'"
                        confirm="La orden se cancelará. ¿Continuar?"/>
                <button name="action_warranty_reentry" string="Reingreso por garantía" type="object"
                        invisible="status != 'delivered'"/>
            </xpath>
            <xpath expr="//field[@name='status']" position="attributes">
                <attribute name="statusbar_visible">draft,diagnosing,quote,repairing,done,delivered</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_reentries" type="object" class="oe_stat_button"
                            icon="fa-repeat" invisible="reentry_count == 0">
                        <field name="reentry_count" widget="statinfo" string="Reingresos"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='promise_date']" position="after">
                <field name="no_charge" invisible="not no_charge"/>
                <field name="warranty_of_id" invisible="not warranty_of_id"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="before">
                <separator string="Servicios del catálogo"/>
                <field name="service_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <separator string="Repuestos"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pagos">
                    <field name="payment_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="method"/>
                            <field name="note"/>
                            <field name="currency_id" invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total" readonly="1"/>
                        <field name="paid_total"/>
                        <field name="balance" class="oe_subtotal_footer_separator"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_service_order_tree_extras" model="ir.ui.view">
        <field name="name">service.order.tree.extras</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='total']" position="after">
                <field name="balance" optional="show" sum="Saldo"/>
            </xpath>
        </field>
    </record>

    <record id="view_service_order_search_extras" model="ir.ui.view">
        <field name="name">service.order.search.extras</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='f_mine']" position="after">
                <filter name="f_quote" string="Esperando aprobación" domain="[('status', '=', 'quote')]"/>
                <filter name="f_balance" string="Con saldo"
                        domain="[('balance', '&gt;', 0), ('status', '!=', 'cancel')]"/>
            </xpath>
        </field>
    </record>

    <template id="report_service_order_extras" inherit_id="report_service_order">
        <xpath expr="//h2" position="replace">
            <h2>
                <t t-if="o.status == 'quote'">Presupuesto</t>
                <t t-else="">Orden de Servicio</t>
                <span t-field="o.name"/>
            </h2>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="o.paid_total">
                <p>
                    <strong>Pagado:</strong> <span t-field="o.paid_total"/>
                    &#160;&#160;&#160;
                    <strong>Saldo:</strong> <span t-field="o.balance"/>
                </p>
            </t>
            <t t-if="o.status == 'quote'">
                <p class="mt-4">Para comenzar la reparación necesitamos su aprobación de este presupuesto.</p>
                <p class="mt-5">Aprobado por: ______________________ &#160;&#160; Fecha: ____________</p>
            </t>
        </xpath>
    </template>

    <record id="view_service_catalog_tree" model="ir.ui.view">
        <field name="name">service.catalog.tree</field>
        <field name="model">service.catalog</field>
        <field name="arch" type="xml">
            <list string="Catálogo de servicios" editable="bottom">
                <field name="name"/>
                <field name="currency_id" invisible="1"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="view_service_payment_tree" model="ir.ui.view">
        <field name="name">service.payment.tree</field>
        <field name="model">service.payment</field>
        <field name="arch" type="xml">
            <list string="Pagos recibidos" create="false">
                <field name="date"/>
                <field name="order_id"/>
                <field name="method"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_service_payment_pivot" model="ir.ui.view">
        <field name="name">service.payment.pivot</field>
        <field name="model">service.payment</field>
        <field name="arch" type="xml">
            <pivot string="Pagos recibidos">
                <field name="date" interval="month" type="row"/>
                <field name="method" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_service_catalog" model="ir.actions.act_window">
        <field name="name">Catálogo de servicios</field>
        <field name="res_model">service.catalog</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_service_payment" model="ir.actions.act_window">
        <field name="name">Pagos recibidos</field>
        <field name="res_model">service.payment</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <menuitem id="menu_taller_config" name="Configuración" parent="menu_taller_root"
              sequence="40" groups="group_taller_manager"/>
    <menuitem id="menu_taller_catalog" name="Catálogo de servicios" parent="menu_taller_config"
              action="action_service_catalog" sequence="10"/>
    <menuitem id="menu_taller_payments" name="Pagos recibidos" parent="menu_taller_reports"
              action="action_service_payment" sequence="40"/>
</odoo>