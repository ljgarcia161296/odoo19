<odoo>
    <record id="view_service_order_form_analytics" model="ir.ui.view">
        <field name="name">service.order.form.analytics</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//group[hasclass('oe_subtotal_footer')])[1]" position="after">
                <group class="oe_right" groups="taller.group_taller_manager">
                    <field name="parts_cost"/>
                    <field name="margin"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Checklist">
                    <button name="action_load_checklist" string="Cargar puntos faltantes"
                            type="object" class="btn-secondary"/>
                    <field name="check_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="result"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <template id="report_service_order_checklist" inherit_id="report_service_order">
        <xpath expr="//h5[text()='Repuestos']" position="before">
            <t t-if="o.check_ids.filtered_domain([('result', '!=', 'untested')])">
                <h5>Chequeo de ingreso</h5>
                <table class="table table-sm">
                    <tbody>
                        <tr t-foreach="o.check_ids.filtered_domain([('result', '!=', 'untested')])" t-as="c">
                            <td><span t-field="c.name"/></td>
                            <td><span t-field="c.result"/></td>
                            <td><span t-field="c.note"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
    </template>

    <record id="view_service_checklist_item_tree" model="ir.ui.view">
        <field name="name">service.checklist.item.tree</field>
        <field name="model">service.checklist.item</field>
        <field name="arch" type="xml">
            <list string="Puntos del checklist" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="device_type"/>
            </list>
        </field>
    </record>

    <record id="view_profit_pivot" model="ir.ui.view">
        <field name="name">service.order.pivot.profit</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <pivot string="Rentabilidad por mes">
                <field name="date_received" interval="month" type="row"/>
                <field name="total" type="measure"/>
                <field name="parts_cost" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_profit_part_pivot" model="ir.ui.view">
        <field name="name">service.order.line.pivot.profit</field>
        <field name="model">service.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Rentabilidad por repuesto">
                <field name="part_id" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="subtotal" type="measure"/>
                <field name="cost_subtotal" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_productivity_pivot" model="ir.ui.view">
        <field name="name">service.order.pivot.productivity</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <pivot string="Productividad por técnico">
                <field name="user_id" type="row"/>
                <field name="delivered_flag" type="measure"/>
                <field name="days_to_finish" type="measure"/>
                <field name="reentry_flag" type="measure"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_profit_month" model="ir.actions.act_window">
        <field name="name">Rentabilidad por mes</field>
        <field name="res_model">service.order</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_profit_pivot"/>
        <field name="search_view_id" ref="view_service_order_search"/>
        <field name="context">{'search_default_f_delivered': 1}</field>
    </record>

    <record id="action_profit_part" model="ir.actions.act_window">
        <field name="name">Rentabilidad por repuesto</field>
        <field name="res_model">service.order.line</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_profit_part_pivot"/>
        <field name="domain">[('part_id', '!=', False), ('order_id.status', '=', 'delivered')]</field>
    </record>

    <record id="action_productivity" model="ir.actions.act_window">
        <field name="name">Productividad por técnico</field>
        <field name="res_model">service.order</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_productivity_pivot"/>
        <field name="search_view_id" ref="view_service_order_search"/>
        <field name="context">{'search_default_f_delivered': 1}</field>
    </record>

    <record id="action_checklist_items" model="ir.actions.act_window">
        <field name="name">Puntos del checklist</field>
        <field name="res_model">service.checklist.item</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_taller_checklist" name="Puntos del checklist" parent="menu_taller_config"
              action="action_checklist_items" sequence="20"/>
    <menuitem id="menu_taller_profit_month" name="Rentabilidad por mes" parent="menu_taller_reports"
              action="action_profit_month" sequence="50"/>
    <menuitem id="menu_taller_profit_part" name="Rentabilidad por repuesto" parent="menu_taller_reports"
              action="action_profit_part" sequence="60"/>
    <menuitem id="menu_taller_productivity" name="Productividad por técnico" parent="menu_taller_reports"
              action="action_productivity" sequence="70"/>
</odoo>