<odoo>
    <record id="view_service_order_pivot" model="ir.ui.view">
        <field name="name">service.order.pivot</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de órdenes">
                <field name="date_received" interval="month" type="row"/>
                <field name="status" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_service_order_graph" model="ir.ui.view">
        <field name="name">service.order.graph</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <graph string="Órdenes por estado" type="bar">
                <field name="status"/>
            </graph>
        </field>
    </record>

    <record id="view_service_order_line_pivot" model="ir.ui.view">
        <field name="name">service.order.line.pivot</field>
        <field name="model">service.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Repuestos usados">
                <field name="name" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_service_order_line_graph" model="ir.ui.view">
        <field name="name">service.order.line.graph</field>
        <field name="model">service.order.line</field>
        <field name="arch" type="xml">
            <graph string="Repuestos usados" type="bar" order="DESC">
                <field name="name"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_service_order_search_analysis" model="ir.ui.view">
        <field name="name">service.order.search.analysis</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='f_mine']" position="after">
                <filter name="f_delivered" string="Entregadas" domain="[('status', '=', 'delivered')]"/>
            </xpath>
            <xpath expr="//filter[@name='g_user']" position="after">
                <filter name="g_month" string="Mes de ingreso" context="{'group_by': 'date_received:month'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_service_order_analysis" model="ir.actions.act_window">
        <field name="name">Análisis de órdenes</field>
        <field name="res_model">service.order</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_service_order_search"/>
    </record>

    <record id="action_service_order_line_analysis" model="ir.actions.act_window">
        <field name="name">Repuestos usados</field>
        <field name="res_model">service.order.line</field>
        <field name="view_mode">pivot,graph</field>
    </record>

    <menuitem id="menu_taller_reports" name="Reportes" parent="menu_taller_root"
              sequence="30" groups="group_taller_manager"/>
    <menuitem id="menu_taller_analysis" name="Análisis de órdenes" parent="menu_taller_reports"
              action="action_service_order_analysis" sequence="10"/>
    <menuitem id="menu_taller_parts_analysis" name="Repuestos usados" parent="menu_taller_reports"
              action="action_service_order_line_analysis" sequence="20"/>
</odoo>