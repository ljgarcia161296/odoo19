<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="taller.Dashboard">
        <div class="o_taller_dashboard">
            <div class="td-hero">
                <span class="td-blob td-blob-1"/>
                <span class="td-blob td-blob-2"/>
                <span class="td-blob td-blob-3"/>
                <div class="td-hero-text">
                    <div class="td-hello"><t t-out="greeting"/>, <t t-out="state.data.user"/></div>
                    <div class="td-sub">Resumen de tu taller · <t t-out="state.data.today"/></div>
                </div>
                <div class="td-actions">
                    <button class="td-btn td-btn-primary" t-on-click="() => this.newOrder()">
                        <i class="fa fa-plus"/> Nueva orden
                    </button>
                    <button class="td-btn" t-on-click="() => this.goTo('taller.action_taller_board')">
                        <i class="fa fa-columns"/> Órdenes
                    </button>
                    <button class="td-btn" t-on-click="() => this.goTo('taller.action_taller_clientes_ui')">
                        <i class="fa fa-users"/> Clientes
                    </button>
                    <t t-if="state.data.is_manager">
                        <button class="td-btn" t-on-click="() => this.goTo('taller.action_to_invoice')">
                            <i class="fa fa-file-text-o"/> Por facturar
                        </button>
                        <button class="td-btn" t-on-click="() => this.goTo('taller.action_suggest_purchase')">
                            <i class="fa fa-shopping-cart"/> Compra sugerida
                        </button>
                    </t>
                    <button class="td-btn td-btn-icon" title="Actualizar" t-on-click="() => this.refresh()">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
            </div>

            <div t-if="state.extra" class="td-today">
                <div class="td-today-item"><i class="fa fa-sign-in"/><span>Ingresaron hoy</span><b><t t-out="state.extra.created_today"/></b></div>
                <div class="td-today-item"><i class="fa fa-check-circle"/><span>Entregadas hoy</span><b><t t-out="state.extra.delivered_today"/></b></div>
                <t t-if="state.extra.is_manager">
                    <div class="td-today-item"><i class="fa fa-money"/><span>Cobrado hoy</span><b><t t-out="moneyExtra(state.extra.cash_today)"/></b></div>
                    <div class="td-today-item"><i class="fa fa-shopping-cart"/><span>Ventas de mostrador</span><b><t t-out="state.extra.sales_today"/></b></div>
                </t>
            </div>

            <div class="td-grid">
                <div t-foreach="state.data.kpis" t-as="kpi" t-key="kpi.key"
                     t-attf-class="td-card td-tone-#{kpi.tone} #{kpi.alert ? 'td-alert' : ''} #{kpi.changed ? 'td-changed' : ''}"
                     t-attf-style="animation-delay: #{kpi_index * 70}ms"
                     draggable="true" title="Arrastrá para reordenar"
                     t-on-dragstart="(ev) => this.kpiDragStart(kpi, ev)"
                     t-on-dragover.prevent=""
                     t-on-drop="(ev) => this.kpiDrop(kpi, ev)"
                     t-on-click="() => this.openKpi(kpi)">
                    <div class="td-card-icon"><i t-attf-class="fa #{kpi.icon}"/></div>
                    <div class="td-card-value"><t t-out="format(kpi, kpi_index)"/></div>
                    <div class="td-card-label"><t t-out="kpi.label"/></div>
                </div>
            </div>

            <div t-if="state.extra and attentionCount" class="td-panel td-attention">
                <div class="td-panel-title"><i class="fa fa-bell-o"/> Requiere atención <span class="td-count"><t t-out="attentionCount"/></span></div>
                <div class="td-att-cols">
                    <div t-if="state.extra.attention.late.length" class="td-att-col">
                        <div class="td-att-title td-red">Atrasadas</div>
                        <div t-foreach="state.extra.attention.late" t-as="o" t-key="o.id" class="td-recent" t-on-click="() => this.openOrder(o.id)">
                            <div class="td-recent-main"><div class="td-recent-name"><t t-out="o.name"/> · <t t-out="o.customer"/></div>
                                <div class="td-recent-sub"><t t-out="o.device"/> · <t t-out="o.extra"/></div></div>
                        </div>
                    </div>
                    <div t-if="state.extra.attention.waiting.length" class="td-att-col">
                        <div class="td-att-title td-amber">Listas sin retirar</div>
                        <div t-foreach="state.extra.attention.waiting" t-as="o" t-key="o.id" class="td-recent" t-on-click="() => this.openOrder(o.id)">
                            <div class="td-recent-main"><div class="td-recent-name"><t t-out="o.name"/> · <t t-out="o.customer"/></div>
                                <div class="td-recent-sub"><t t-out="o.device"/> · <t t-out="o.extra"/></div></div>
                        </div>
                    </div>
                    <div t-if="state.extra.attention.quotes.length" class="td-att-col">
                        <div class="td-att-title td-blue">Presupuestos sin respuesta</div>
                        <div t-foreach="state.extra.attention.quotes" t-as="o" t-key="o.id" class="td-recent" t-on-click="() => this.openOrder(o.id)">
                            <div class="td-recent-main"><div class="td-recent-name"><t t-out="o.name"/> · <t t-out="o.customer"/></div>
                                <div class="td-recent-sub"><t t-out="o.device"/> · <t t-out="o.extra"/></div></div>
                        </div>
                    </div>
                    <div t-if="state.extra.attention.low_stock.length" class="td-att-col">
                        <div class="td-att-title td-purple">Stock bajo</div>
                        <div t-foreach="state.extra.attention.low_stock" t-as="p" t-key="p.id" class="td-recent" t-on-click="openPartList">
                            <div class="td-recent-main"><div class="td-recent-name"><t t-out="p.name"/></div>
                                <div class="td-recent-sub">Hay <t t-out="p.stock"/> · mínimo <t t-out="p.min"/></div></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="td-columns">
                <div class="td-panel">
                    <div class="td-panel-title">Órdenes por semana</div>
                    <div class="td-legend">
                        <span><i class="td-dot-a"/>Recibidas</span>
                        <span><i class="td-dot-b"/>Entregadas</span>
                    </div>
                    <t t-set="chart" t-value="trendChart"/>
                    <svg class="td-chart" viewBox="0 0 520 190">
                        <g t-foreach="chart.grid" t-as="g" t-key="g_index">
                            <line t-att-x1="chart.axisStart" t-att-x2="chart.axisEnd" t-att-y1="g.y" t-att-y2="g.y" class="td-grid-line"/>
                            <text x="28" t-att-y="g.y + 3" text-anchor="end" class="td-axis"><t t-out="g.label"/></text>
                        </g>
                        <text t-foreach="chart.labels" t-as="l" t-key="l_index" t-att-x="l.x" t-att-y="chart.labelY"
                              text-anchor="middle" class="td-axis"><t t-out="l.text"/></text>
                        <polygon t-att-points="chart.received.area" class="td-area td-area-a"/>
                        <polygon t-att-points="chart.delivered.area" class="td-area td-area-b"/>
                        <polyline t-att-points="chart.received.line" class="td-line td-line-a"/>
                        <polyline t-att-points="chart.delivered.line" class="td-line td-line-b"/>
                        <circle t-foreach="chart.received.dots" t-as="d" t-key="d_index" t-att-cx="d.x" t-att-cy="d.y" r="3.6" class="td-dot td-dot-a">
                            <title><t t-out="d.tip"/></title>
                        </circle>
                        <circle t-foreach="chart.delivered.dots" t-as="d" t-key="d_index" t-att-cx="d.x" t-att-cy="d.y" r="3.6" class="td-dot td-dot-b">
                            <title><t t-out="d.tip"/></title>
                        </circle>
                    </svg>
                </div>

                <div class="td-panel" t-if="incomeChart">
                    <div class="td-panel-title">Ingresos por mes</div>
                    <t t-set="inc" t-value="incomeChart"/>
                    <svg class="td-chart" viewBox="0 0 520 190">
                        <line x1="10" x2="510" t-att-y1="inc.baseline" t-att-y2="inc.baseline" class="td-grid-line"/>
                        <g t-foreach="inc.bars" t-as="b" t-key="b_index">
                            <rect t-att-x="b.x" t-att-y="b.y" t-att-width="b.w" t-att-height="b.h" rx="4"
                                  class="td-bar-income" t-attf-style="animation-delay: #{b_index * 90}ms">
                                <title><t t-out="b.tip"/></title>
                            </rect>
                            <text t-att-x="b.cx" t-att-y="b.y - 6" class="td-bar-value"><t t-out="b.text"/></text>
                            <text t-att-x="b.cx" t-att-y="inc.labelY" class="td-bar-label"><t t-out="b.label"/></text>
                        </g>
                    </svg>
                </div>
            </div>

            <div class="td-columns">
                <div class="td-panel">
                    <div class="td-panel-title">Órdenes por estado</div>
                    <div t-foreach="state.data.stages" t-as="stage" t-key="stage.key"
                         t-attf-class="td-stage td-stage-#{stage.key}"
                         t-on-click="() => this.openStage(stage)">
                        <div class="td-stage-name"><t t-out="stage.label"/></div>
                        <div class="td-bar">
                            <div class="td-bar-fill"
                                 t-attf-style="width: #{state.barsReady ? stage.pct : 0}%"/>
                        </div>
                        <div class="td-stage-count"><t t-out="stage.count"/></div>
                    </div>
                </div>

                <div class="td-panel">
                    <div class="td-panel-title">Últimas órdenes</div>
                    <div t-if="!state.data.recent.length" class="td-empty">Todavía no hay órdenes.</div>
                    <div t-foreach="state.data.recent" t-as="order" t-key="order.id"
                         class="td-recent" t-on-click="() => this.openOrder(order.id)">
                        <div class="td-recent-main">
                            <div class="td-recent-name"><t t-out="order.name"/> · <t t-out="order.customer"/></div>
                            <div class="td-recent-sub"><t t-out="order.device"/> · <t t-out="order.date"/></div>
                        </div>
                        <span t-attf-class="td-pill td-pill-#{order.status}"><t t-out="order.status_label"/></span>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>