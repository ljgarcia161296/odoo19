<odoo noupdate="1">
    <record id="param_recurrence_days" model="ir.config_parameter">
        <field name="key">taller.recurrence_days</field>
        <field name="value">90</field>
    </record>
    <record id="param_quote_followup_days" model="ir.config_parameter">
        <field name="key">taller.quote_followup_days</field>
        <field name="value">3</field>
    </record>

    <record id="cron_quote_followup" model="ir.cron">
        <field name="name">Taller: seguimiento de presupuestos sin respuesta</field>
        <field name="model_id" ref="model_service_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_quote_followup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>