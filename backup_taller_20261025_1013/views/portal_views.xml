<odoo>
    <template id="status_not_found" name="Orden no encontrada">
        <t t-call="web.layout">
            <t t-set="title">Orden no encontrada</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
            </t>
            <div style="max-width: 480px; margin: 40px auto; padding: 16px; font-family: Arial, sans-serif; text-align: center;">
                <h2>No encontramos esa orden</h2>
                <p>El enlace no es válido. Pida uno nuevo al taller.</p>
            </div>
        </t>
    </template>

    <template id="status_page" name="Estado de su equipo">
        <t t-call="web.layout">
            <t t-set="title">Estado de su equipo</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body { font-family: -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; background: #f4f6f8; margin: 0; color: #1b2a30; }
                    .tp-wrap { max-width: 520px; margin: 0 auto; padding: 16px; }
                    .tp-card { background: #fff; border-radius: 12px; padding: 18px; margin-bottom: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
                    h1 { font-size: 20px; margin: 4px 0; }
                    .muted { color: #667; font-size: 13px; }
                    .steps { list-style: none; padding: 0; margin: 12px 0 0; }
                    .step { padding: 8px 0 8px 28px; position: relative; color: #99a; }
                    .step:before { content: ''; position: absolute; left: 4px; top: 12px; width: 12px; height: 12px; border-radius: 50%; background: #d5dae0; }
                    .step.done { color: #1b2a30; }
                    .step.done:before { background: #0f4c5c; }
                    .step.now { color: #0f4c5c; font-weight: 700; }
                    .step.now:before { background: #e8a33d; }
                    .row { display: flex; justify-content: space-between; padding: 4px 0; }
                    .stars label { display: inline-block; margin-right: 10px; }
                    textarea { width: 100%; box-sizing: border-box; min-height: 70px; margin-top: 8px; }
                    button { background: #0f4c5c; color: #fff; border: 0; border-radius: 8px; padding: 10px 18px; margin-top: 10px; font-size: 15px; }
                </style>
            </t>
            <div class="tp-wrap">
                <div class="tp-card">
                    <div class="muted"><t t-out="request.env.company.name"/></div>
                    <h1>Orden <t t-out="order.name"/></h1>
                    <div><t t-out="device"/></div>
                    <div class="muted"><t t-out="customer"/></div>
                </div>

                <div class="tp-card" t-if="thanks">
                    <strong>¡Gracias por su valoración!</strong>
                </div>

                <div class="tp-card">
                    <strong>Estado: <t t-out="status_label"/></strong>
                    <ul class="steps" t-if="order.status != 'cancel'">
                        <li t-foreach="steps" t-as="s"
                            t-attf-class="step #{'done' if s_index &lt; current else ('now' if s_index == current else '')}">
                            <t t-out="s[1]"/>
                        </li>
                    </ul>
                    <div class="row" t-if="promise"><span>Entrega estimada</span><span><t t-out="promise"/></span></div>
                    <div class="row" t-if="ready"><span>Disponible desde</span><span><t t-out="ready"/></span></div>
                    <div class="row" t-if="amount"><span>Total</span><span><t t-out="amount"/></span></div>
                    <div class="row" t-if="balance"><span>Saldo a pagar</span><span><t t-out="balance"/></span></div>
                </div>

                <t t-if="order.status == 'delivered' and not order.rating">
                    <div class="tp-card">
                        <form method="post" t-attf-action="/taller/encuesta/#{token}">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <strong>¿Cómo fue su experiencia?</strong>
                            <div class="stars" style="margin-top: 8px;">
                                <label><input type="radio" name="rating" value="1" required="required"/> 1</label>
                                <label><input type="radio" name="rating" value="2"/> 2</label>
                                <label><input type="radio" name="rating" value="3"/> 3</label>
                                <label><input type="radio" name="rating" value="4"/> 4</label>
                                <label><input type="radio" name="rating" value="5"/> 5</label>
                            </div>
                            <div class="muted">1 = muy mala, 5 = excelente</div>
                            <textarea name="comment" placeholder="Comentario (opcional)"></textarea>
                            <button type="submit">Enviar valoración</button>
                        </form>
                    </div>
                </t>
                <t t-elif="order.rating">
                    <div class="tp-card muted">Su valoración: <t t-out="order.rating"/> de 5. ¡Gracias!</div>
                </t>

                <div class="tp-card muted" t-if="request.env.company.phone">
                    Consultas: <t t-out="request.env.company.phone"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_service_order_portal" inherit_id="report_service_order">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="o.public_url">
                <div class="mt-4" style="page-break-inside: avoid;">
                    <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=150&amp;height=150' % o.public_qr_value"
                         style="width: 80px; height: 80px; float: left; margin-right: 10px;"/>
                    <p>Siga el estado de su equipo escaneando este código o ingresando a:<br/>
                        <span t-out="o.public_url"/></p>
                </div>
            </t>
        </xpath>
    </template>

    <record id="view_service_order_form_portal" model="ir.ui.view">
        <field name="name">service.order.form.portal</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="before">
                <button name="action_whatsapp_link" string="Enviar seguimiento" type="object"
                        icon="fa-whatsapp" invisible="not partner_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Seguimiento y valoración">
                    <group>
                        <group string="Enlace para el cliente">
                            <field name="public_url" widget="url"
                                   invisible="not public_url"/>
                        </group>
                        <group string="Valoración del cliente">
                            <field name="rating"/>
                            <field name="rating_comment"/>
                            <field name="rating_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_service_order_search_portal" model="ir.ui.view">
        <field name="name">service.order.search.portal</field>
        <field name="model">service.order</field>
        <field name="inherit_id" ref="view_service_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='f_mine']" position="after">
                <filter name="f_rated" string="Valoradas" domain="[('rating', '!=', False)]"/>
                <filter name="f_low_rating" string="Valoración baja" domain="[('rating', 'in', ['1', '2'])]"/>
            </xpath>
        </field>
    </record>

    <record id="view_ratings_tree" model="ir.ui.view">
        <field name="name">service.order.tree.ratings</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <list string="Valoraciones" create="false">
                <field name="rating_date"/>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="user_id"/>
                <field name="rating"/>
                <field name="rating_comment"/>
            </list>
        </field>
    </record>

    <record id="view_satisfaction_pivot" model="ir.ui.view">
        <field name="name">service.order.pivot.satisfaction</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <pivot string="Satisfacción del cliente">
                <field name="user_id" type="row"/>
                <field name="order_qty" type="measure"/>
                <field name="rating_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ratings" model="ir.actions.act_window">
        <field name="name">Valoraciones</field>
        <field name="res_model">service.order</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ratings_tree"/>
        <field name="domain">[('rating', '!=', False)]</field>
        <field name="search_view_id" ref="view_service_order_search"/>
    </record>

    <record id="action_satisfaction" model="ir.actions.act_window">
        <field name="name">Satisfacción del cliente</field>
        <field name="res_model">service.order</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_satisfaction_pivot"/>
        <field name="domain">[('rating', '!=', False)]</field>
        <field name="search_view_id" ref="view_service_order_search"/>
    </record>

    <menuitem id="menu_taller_satisfaction" name="Satisfacción del cliente"
              parent="menu_taller_reports" action="action_satisfaction" sequence="90"/>
    <menuitem id="menu_taller_ratings" name="Valoraciones"
              parent="menu_taller_reports" action="action_ratings" sequence="91"/>
</odoo>