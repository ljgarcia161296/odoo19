<odoo>
    <record id="module_category_taller" model="ir.module.category">
        <field name="name">Taller</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_taller" model="res.groups.privilege">
        <field name="name">Taller</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_taller"/>
    </record>

    <record id="group_taller_technician" model="res.groups">
        <field name="name">Técnico</field>
        <field name="privilege_id" ref="res_groups_privilege_taller"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="group_taller_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="res_groups_privilege_taller"/>
        <field name="implied_ids" eval="[(4, ref('group_taller_technician')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
